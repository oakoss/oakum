{
  "[json][jsonc][toml][yaml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "editor.formatOnSave": true,
  // rumdl owns markdown here, so markdownlint must not also report on it.
  "markdownlint.appliesTo": "noFiles",
  // Stated explicitly so markdown linting here does not depend on whatever each
  // contributor's global default happens to be.
  "rumdl.enable": true
}
