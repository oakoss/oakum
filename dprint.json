{
  "excludes": [
    "Cargo.lock",
    "**/pnpm-lock.yaml",
    ".beads/**",
    "**/*.md",
    "crates/oakum/src/manifest/fixtures/**"
  ],
  "indentWidth": 2,
  "json": {},
  "lineWidth": 80,
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ],
  "toml": {
    "overrides": {
      "files": [".changeset/**"],
      "comment.forceLeadingSpace": false
    }
  },
  "useTabs": false,
  "yaml": {
    "quotes": "preferSingle"
  }
}
